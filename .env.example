# ============================================================
# UMKM Jatim Marketplace — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env!
# ============================================================

# --- Database ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=UmkmJatimDb
DB_USER=sa
DB_PASSWORD=YourStrongP@ssw0rd!

# Full connection string (overrides above in API)
CONNECTION_STRING="Server=localhost,1433;Database=UmkmJatimDb;User Id=sa;Password=YourStrongP@ssw0rd!;TrustServerCertificate=True;"

# --- JWT ---
JWT_SECRET=your-super-secret-key-min-32-chars-change-this!
JWT_ISSUER=UmkmJatimAPI
JWT_AUDIENCE=UmkmJatimClient
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# --- Midtrans (Sandbox) ---
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# --- File Upload ---
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
UPLOAD_PATH=uploads

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Serilog / Logging ---
LOG_LEVEL=Information
SEQ_URL=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:5000/api
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
VITE_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

